{
	"schemaVersion": 1,
	"id": "glacier",
	"version": "${version}",
	"name": "Glacier Client",
	"description": "A lightweight Minecraft client mod: HUD modules, cosmetics, zoom, free look and built-in performance mods, tuned for low-end laptops.",
	"authors": ["Pepe"],
	"contact": {
		"homepage": "https://github.com/PepeOnGithub",
		"sources": "https://github.com/PepeOnGithub"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/glacier/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["net.glacier.GlacierClient"]
	},
	"mixins": [
		"glacier.mixins.json"
	, "glacier-extra-a.mixins.json", "glacier-extra-b.mixins.json", "glacier-extra-c.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*"
	},
	"breaks": {
		"optifabric": "*"
	}
}
